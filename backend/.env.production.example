# Night Watch - Production Environment Variables
# Copier ce fichier vers .env et configurer avec vos vraies valeurs

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DB_HOST=localhost
DB_USER=nightwatch_user
DB_PASSWORD=GENERER_UN_MOT_DE_PASSE_FORT_ICI
DB_NAME=night_watch_db

# Clé de chiffrement (DOIT faire exactement 32 caractères)
# Générer avec: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
DB_ENCRYPTION_KEY=GENERER_UNE_CLE_DE_32_CARACTERES

# ==========================================
# JWT CONFIGURATION
# ==========================================
# Secrets JWT (minimum 32 caractères)
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GENERER_UNE_CLE_SECRETE_JWT_MINIMUM_32_CHARS
JWT_REFRESH_SECRET=GENERER_UNE_AUTRE_CLE_SECRETE_JWT
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=production

# URL du frontend (IMPORTANT: changer en production)
FRONTEND_URL=https://votre-domaine.com

# ==========================================
# EMAIL CONFIGURATION (SMTP)
# ==========================================
# Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=mot-de-passe-application-16-chars
EMAIL_FROM=noreply@votre-domaine.com

# Autre fournisseur SMTP
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=votre-sendgrid-api-key

# ==========================================
# FILE UPLOAD CONFIGURATION
# ==========================================
# Taille maximale en octets (5MB = 5242880)
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ==========================================
# HR API INTEGRATION (COMBO)
# ==========================================
# Laisser vide si non utilisé
COMBO_API_KEY=
COMBO_API_URL=https://api.combo.com/v1

# ==========================================
# SECURITY CONFIGURATION
# ==========================================
# Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# CORS (IMPORTANT: changer en production)
CORS_ORIGIN=https://votre-domaine.com

# ==========================================
# NOTES DE SÉCURITÉ
# ==========================================
# 1. NE JAMAIS commiter ce fichier dans Git
# 2. Utiliser des mots de passe forts et uniques
# 3. Générer de nouvelles clés pour chaque environnement
# 4. Changer toutes les valeurs par défaut
# 5. Restreindre les accès à ce fichier (chmod 600)

# ==========================================
# COMMANDES UTILES
# ==========================================
# Générer clé encryption (32 chars):
# node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
#
# Générer secret JWT (64 chars):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Mot de passe fort aléatoire:
# node -e "console.log(require('crypto').randomBytes(20).toString('base64'))"
#
# Tester la configuration:
# node check-env.js
