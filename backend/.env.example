# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=night_watch_db
DB_ENCRYPTION_KEY=your-32-character-encryption-key-here

# JWT
JWT_SECRET=your-very-secure-jwt-secret-key-minimum-32-characters
JWT_REFRESH_SECRET=your-refresh-token-secret-key-minimum-32-characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@nightwatch.com

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# HR API Integration (Combo)
COMBO_API_KEY=your-combo-api-key
COMBO_API_URL=https://api.combo.com/v1

# Security
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
CORS_ORIGIN=http://localhost:3000
