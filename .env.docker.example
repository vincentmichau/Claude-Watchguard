# Docker Compose Environment Variables
# Copy this file to .env and configure with your values

# Database
DB_ROOT_PASSWORD=secure_root_password_change_me
DB_NAME=night_watch_db
DB_USER=nightwatch_user
DB_PASSWORD=secure_db_password_change_me

# Redis
REDIS_PASSWORD=secure_redis_password_change_me

# Backend
DB_ENCRYPTION_KEY=generate_32_character_key_here
JWT_SECRET=generate_jwt_secret_minimum_32_chars
JWT_REFRESH_SECRET=generate_refresh_secret_minimum_32_chars

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Frontend URLs
FRONTEND_URL=http://localhost
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_SOCKET_URL=http://localhost:5000

# Production URLs (when using nginx profile)
# FRONTEND_URL=https://votre-domaine.com
# REACT_APP_API_URL=https://votre-domaine.com/api
# REACT_APP_SOCKET_URL=https://votre-domaine.com

# Generate secure keys with:
# docker run --rm node:18-alpine node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
